{
  "name": "remove-free",
  "version": "1.0.0",
  "description": "Privacy-first local WebGPU remove.bg clone for humans and agents built with TanStack Start, shadcn sidebar-08, and Cloudflare primitives",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "find . -name '._*' -not -path './node_modules/*' -delete 2>/dev/null; find . -name '.DS_Store' -not -path './node_modules/*' -delete 2>/dev/null; true",
    "build": "pnpm prebuild && vite build && tsc --noEmit && vitest run --silent",
    "build:cf": "pnpm build && pnpm postbuild:cf",
    "deploy:cf": "pnpm build:cf && npx wrangler pages deploy dist",
    "preview": "vite preview",
    "postbuild:cf": "node scripts/postbuild-cf.mjs",
    "sync:weights": "node scripts/sync-weights.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:route": "node tools/route-check.mjs",
    "test:parity": "node tools/parity-check.mjs",
    "test:share": "node tools/share-check.mjs",
    "shot:models": "node tools/model-sheet.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@meta-sam/parser": "0.1.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.39.0",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.185.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.14",
    "vitest": "^3.2.7"
  }
}
