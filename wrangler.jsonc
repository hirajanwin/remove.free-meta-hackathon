{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remove-free",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "dist",
  "vars": {
    "APP_ENV": "production",
    "APP_NAME": "remove.free",
    "PRIVACY_MODE": "100%_CLIENT_SIDE_WEBGPU"
  }
}
